# Copia este archivo como .env (chmod 600 .env): ahí va el token, y nunca se sube al repositorio.

# --- Modo recomendado: Cloudflare Tunnel en su propio contenedor ---
COMPOSE_PROFILES=tunel
# Zero Trust → Networks → Tunnels → Create a tunnel (Cloudflared) → elige Docker y copia
# solo el token (el texto largo que va después de --token)
TUNNEL_TOKEN=

# --- Modo con tu propio proxy (Caddy/Nginx): comenta las dos líneas de arriba y descomenta esta ---
# COMPOSE_FILE=compose.yaml:compose.puerto.yaml

# Página del juego que puede conectarse (con https:// y sin barra final; varias, separadas por comas)
ORIGENES=https://classbots.eehub.ing
DIAS_RETENCION=180
MAX_ALUMNOS=300
