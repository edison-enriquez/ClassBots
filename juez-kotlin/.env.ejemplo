# Orígenes que pueden usar el juez (el sitio del juego), separados por comas
ORIGENES=https://classbots.eehub.ing
# Intentos que se evalúan a la vez (cada uno usa ~1,5 GB y varios núcleos)
SLOTS=2
MAX_COLA=80
# Memoria del worker: incluye los tmpfs (casa de Gradle ~1-2 GB + slots)
MEMORIA=8g
# Tamaño del tmpfs de la casa de Gradle (el log del worker dice cuánto ocupa al arrancar)
CASA=3g
CPUS=6
PUERTO=8788
# Si cloudflared corre en un contenedor: su red (ver compose.tunel.yaml)
# RED_TUNEL=
